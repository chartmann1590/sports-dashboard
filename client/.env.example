# ArenaPulse ads — local dev config (gitignored).
# Copy to .env.local and fill in real IDs. Never commit real IDs.
# Prod builds get these from GitHub Secrets (see .github/workflows/prod-build.yml).
#
#   cp .env.example .env.local
#
# Android wrapper equivalent: root local.properties (also gitignored):
#   admob.appId=ca-app-pub-XXXX~YYYY
#   admob.bannerAdId=ca-app-pub-XXXX/YYYYYY
#   admob.interstitialAdId=ca-app-pub-XXXX/YYYYYY

# Set "true" to force ads on in dev, "false" to force off.
# Default: on for production builds, off for dev.
VITE_ADS_ENABLED=false

# AdMob IDs (full ca-app-pub-... forms; publisher/slot are derived at runtime)
VITE_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
VITE_ADMOB_BANNER_AD_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_INTERSTITIAL_AD_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
